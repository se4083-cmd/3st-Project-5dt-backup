APP_ENV=development
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=cs-flow-ai
JWT_AUDIENCE=cs-flow-api
TOKEN_MINUTES=30
# Recommended local PostgreSQL. compose reads POSTGRES_PASSWORD from .env.
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://csflow:replace-with-a-local-database-password@127.0.0.1:5432/csflow?sslmode=disable
# Without PostgreSQL, explicitly use sqlite+pysqlite:///./csflow.db for development only.
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
POOL_SIZE=5
MAX_OVERFLOW=5
POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
# Manual seed only; no development credentials are built in.
ENABLE_DEV_SEED=false
# Set DEV_SEED_PASSWORD only in your shell when invoking seed.
# Analytics service JWT uses a separately generated secret. Unset = ingest disabled.
# ANALYTICS_SERVICE_SECRET=<generate independently, at least 48 characters>
ANALYTICS_SERVICE_IDS=[]
ANALYTICS_MAX_BYTES=8000000
ANALYTICS_MAX_ROWS=20000
ANALYTICS_STALE_HOURS=24

# Opt-in P1 monitoring (no external provider required)
P1_ENABLED=false

# VOC drafts: separate opt-in; default MOCK never calls Azure
P1_VOC_ENABLED=false
P1_VOC_PROVIDER=MOCK
P1_VOC_AZURE_ENABLED=false
P1_VOC_AZURE_ENDPOINT=
P1_VOC_AZURE_API_KEY=
P1_VOC_AZURE_DEPLOYMENT=
P1_VOC_AZURE_API_VERSION=2024-10-21
P1_VOC_TIMEOUT_SECONDS=10

# Policy version/review workspace only; approval never activates live policies
P1_POLICY_ENABLED=false
