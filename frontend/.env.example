# mock: isolated synthetic week-1 responses; http: requires agreed server contracts.
VITE_DATA_MODE=mock
# Public URLs only. Never put tokens, DB passwords, or service keys in VITE_*.
# Same-origin paths; backend must enforce authentication, allowed teams and permissions.
VITE_SESSION_PATH=
VITE_OVERVIEW_PATH=

# Local development API proxy only; public non-secret origin, never a credential.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
