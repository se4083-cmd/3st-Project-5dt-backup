{
  "name": "cs-flow-ai-v2-local",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "CS Flow AI L2 guidance and L3 handoff development workspace with local retrieval and persistent demo API",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.config.ts",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:api": "node --test backend/tests/*.test.mjs",
    "test:rag": "node --test ai/tests/*.test.mjs",
    "rag:check": "node scripts/rag-check.mjs",
    "rag:rehash": "node scripts/rag-rehash.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run check && npm test && npm run build && npm run verify:build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
